{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:assignment-1:smart-todo:task-store-schema",
  "title": "Smart Todo Task Store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "next_id", "next_creation_order", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "next_id": {"type": "integer", "minimum": 1},
    "next_creation_order": {"type": "integer", "minimum": 0},
    "tasks": {
      "type": "array",
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "priority", "tags", "status", "creation_order"],
      "properties": {
        "id": {"type": "string", "pattern": "^T-[0-9]{6,}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": "string", "maxLength": 2000},
        "priority": {"enum": ["low", "medium", "high"]},
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 32}
        },
        "status": {"enum": ["todo", "in_progress", "done", "cancelled"]},
        "creation_order": {"type": "integer", "minimum": 0}
      }
    }
  }
}
