{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bits-assignment-1a/harness-run.schema.json",
  "title": "Smart Todo harness run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "started_at_utc",
    "completed_at_utc",
    "gates",
    "overall_status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}\\.[0-9]{6}Z$"
    },
    "started_at_utc": {"type": "string", "format": "date-time"},
    "completed_at_utc": {"type": "string", "format": "date-time"},
    "gates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/compileallGate"},
        {"$ref": "#/$defs/ruffGate"},
        {"$ref": "#/$defs/banditGate"},
        {"$ref": "#/$defs/pytestGate"}
      ],
      "items": false
    },
    "overall_status": {"enum": ["passed", "failed"]}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "started_at_utc",
        "completed_at_utc",
        "exit_code",
        "status",
        "stdout_file",
        "stderr_file"
      ],
      "properties": {
        "name": {"type": "string"},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "started_at_utc": {"type": "string", "format": "date-time"},
        "completed_at_utc": {"type": "string", "format": "date-time"},
        "exit_code": {"type": "integer"},
        "status": {"enum": ["passed", "failed"]},
        "stdout_file": {"type": "string", "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"},
        "stderr_file": {"type": "string", "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"}
      }
    },
    "compileallGate": {
      "allOf": [
        {"$ref": "#/$defs/gate"},
        {"properties": {"name": {"const": "compileall"}}}
      ]
    },
    "ruffGate": {
      "allOf": [
        {"$ref": "#/$defs/gate"},
        {"properties": {"name": {"const": "ruff"}}}
      ]
    },
    "banditGate": {
      "allOf": [
        {"$ref": "#/$defs/gate"},
        {"properties": {"name": {"const": "bandit"}}}
      ]
    },
    "pytestGate": {
      "allOf": [
        {"$ref": "#/$defs/gate"},
        {"properties": {"name": {"const": "pytest"}}}
      ]
    }
  }
}
